{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_destructive_git.py\"",
            "timeout": 10,
            "statusMessage": "Checking for destructive git operations..."
          },
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn_verif_before_commit.py\"",
            "timeout": 10,
            "statusMessage": "Verif reelle avant commit (dispositif)..."
          },
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_export_genere.py\"",
            "timeout": 70,
            "statusMessage": "export/ genere : verification de derive avant commit..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_salle_skills.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py .claude/supervision/scan_transcripts.py",
            "timeout": 60,
            "statusMessage": "Supervision agents : scan incremental des transcripts..."
          },
          {
            "type": "command",
            "command": "py .claude/hooks/remind_veille_agentic.py",
            "timeout": 10,
            "statusMessage": "Cadence veille agentic..."
          },
          {
            "type": "command",
            "command": "py .claude/hooks/remind_revue_increment.py",
            "timeout": 10,
            "statusMessage": "Rappel revue d'increment (hub)..."
          },
          {
            "type": "command",
            "command": "py .claude/hooks/point_du_jour.py",
            "timeout": 10,
            "statusMessage": "Point du jour : ce qui attend votre decision..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py .claude/hooks/orchestrator_gate.py",
            "timeout": 10,
            "statusMessage": "Grille de qualification orchestrateur..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "py .claude/supervision/log_usage.py",
            "timeout": 10,
            "statusMessage": "Journal usage agents..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py .claude/supervision/log_usage.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(C:/Users/claude.camus/Documents/VSCode*/.env)",
      "Read(C:/Users/claude.camus/Documents/VSCode*/secrets/**)",
      "Read(C:/Users/claude.camus/Documents/VSCode*/config/credentials.json)"
    ],
    "allow": [
      "Bash(py -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(py -m py_compile *)",
      "Bash(.venv/Scripts/python.exe -m py_compile *)",
      "Bash(py -m coverage *)",
      "Bash(py .claude/dispositif/export_agentic.py --check*)",
      "Bash(py .claude/dispositif/sync_dispositif.py --check*)",
      "Bash(py .claude/dispositif/propager_socle.py --dry-run*)",
      "Bash(py export/install_agentic.py --dry-run*)",
      "Bash(py .claude/hooks/point_du_jour.py*)",
      "Bash(py .claude/orchestration/log_run.py*)",
      "Bash(node -c *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  }
}
